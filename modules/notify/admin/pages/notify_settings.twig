{% extends "layouts" ~ DIR ~ "default.twig" %}

{% block title %}{{ "Notify Settings" | translate("notify") }}{% endblock %}

{% block content %}
<h2>{{ "Notify Settings" | translate("notify") }}</h2>
<form id="notify_settings" class="split" action="{{ url('notify_settings') }}" method="post" accept-charset="UTF-8">
<fieldset>
<h3>{{ "Events:" | translate("notify") }}</h3>
{% for trigger, hook in hook_list %}
<p>
{# translation is done in the module #}
<label for="{{ trigger }}">{{ hook.label | fix(true, true) }}</label>
<input type="checkbox" id="{{ trigger }}" name="hooks[{{ trigger }}]" {{ (site.module_notify.hooks[trigger] ?? false) | checked }}>
</p>
{% endfor %}
</fieldset>
<hr>
<h2>{{ "ntfy.sh" | translate("notify") }}</h2>
<fieldset>
<p>
<label for="ntfy_enabled">
{{ "Enable Notifications" | translate("notify") }}
<a class="emblem" rel="external" href="https://ntfy.sh/" target="_blank">
{{- icon_svg("info.svg", "Info" | translate) -}}
</a>
</label>
<input type="checkbox" id="ntfy_enabled" name="ntfy_enabled" {{ site.module_notify.ntfy_enabled | checked }}>
</p>
<p>
<label for="ntfy_host">{{ "Host" | translate("notify") }}</label>
<input type="url" class="text" name="ntfy_host" id="ntfy_host" value="{{ site.module_notify.ntfy_host | fix(true, true) }}">
</p>
<p>
<label for="ntfy_topic">{{ "Topic" | translate("notify") }}</label>
<input type="text" class="text" name="ntfy_topic" id="ntfy_topic" maxlength="64" pattern="^[\-_a-zA-Z0-9]{4,64}$" value="{{ site.module_notify.ntfy_topic | fix(true, true) }}">
</p>
</fieldset>
<hr>
<p class="buttons">
<button type="submit" class="yay">
{{ "Update" | translate }}
</button>
</p>
<input type="hidden" name="hash" value="{{ authenticate() }}" id="hash">
</form>
{% endblock %}