{% extends "layouts" ~ DIR ~ "default.twig" %}

{% block title %}{{ "Delete Cache?" | translate }}{% endblock %}

{% block content %}
<h2>{{ "Delete Cache?" | translate }}</h2>
<form class="delete" action="{{ url('destroy_cache') }}" method="post" accept-charset="UTF-8">
<fieldset role="presentation">
<p>
{{ "The cache directory &#8220;%s&#8221; will be permanently deleted." | translate | format(name | fix) }}
</p>
<div class="confirmation">
<button name="destroy" value="indubitably" class="boo">
{{ "Delete!" | translate }}
</button>
<button name="destroy" value="undecidedly" type="submit" class="yay">
{{ "Cancel" | translate }}
</button>
</div>
<input type="hidden" name="name" value="{{ name | fix(true) }}" id="name">
<input type="hidden" name="hash" value="{{ authenticate() }}" id="hash">
</fieldset>
</form>
{% endblock %}
